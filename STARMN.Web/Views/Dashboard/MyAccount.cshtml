@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>

    .account {
        width: 900px;
        margin: 60px auto;
        padding: 30px;
    }

    .profile {
        display: flex;
        gap: 30px;
        margin: 30px 0;
        align-items: center;
    }        

    .info p {
        margin: 8px 0;
    }

    .actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 20px;
        background: darkorange;
        color: white;        
        text-decoration: none;
        border-radius: 5px;
    }

    .logout {
        background: #dc3545;
    }
</style>

<section class="account">

    <h1>My Account</h1>
    <p>Manage your account and stay updated.</p>

    <div class="profile">        

        <div class="info">
            <h2>John Doe</h2>
            <p>johndoe@email.com</p>
            <p>Member since 2026</p>
        </div>

    </div>

    <div class="cards">

        <div class="card">
            <h3>Support</h3>
            <p>Need help? Contact our support team anytime.</p>
            <a href="#">Support</a>
       
        </div>

        <div class="card">
            <h3>Wishlist</h3>
            <p>See the monitors you've saved for later.</p>
            <a href="~/Dashboard/Wishlist">Open</a>
        </div>

        <div class="card">
            <h3>Logout</h3>
            <p>Sign out securely from your account.</p>
            <a href="~/Dashboard/Login">Logout</a>
        </div>

    </div>

</section>

