@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>

    .logout {
        width: 450px;
        margin: 80px auto;
        text-align: center;
        border: 1px solid #ddd;
        padding: 40px;
        border-radius: 10px;
    }

        .logout h1 {
            margin-bottom: 15px;
        }

        .logout p {
            margin-bottom: 25px;
            color: #666;
        }
        
        .logout .btn-home {
            display: inline-block;
            padding: 10px 20px;
            margin: 5px;
            text-decoration: none;
            border-radius: 5px;
            background: darkorange;
            color: white;
        }

</style>



<section class="logout">

    <h1>Logged Out</h1>

    <p>
        You have successfully logged out of your account.
    </p>

    <a href="~/Dashboard/Login" class="btn">Login Again</a>

    <a href="~/Anasayfa/Index" class="btn-home">Back to Home</a>

</section>