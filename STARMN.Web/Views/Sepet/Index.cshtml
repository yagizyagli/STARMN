@using STARMN.Core.EntityDTOS
@using STARMN.Web.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<SepetDto>
<style>
    .cart {
        width: 1000px;
        margin: 60px auto;
    }

    .cart-item {
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
    }

    .cart-item img {
      width: 150px;
    }

    .product-info {
        flex: 1;
    }

    .quantity input {
        width: 60px;
    }

    .summary {
        width: 300px;
        margin-left: auto;
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 8px;
    }

    .summary p {
     display: flex;
     justify-content: space-between;
     margin: 15px 0;
    }

    .checkout,
    .remove {
        text-decoration: none;
        color: white;
        padding: 10px 18px;
        border-radius: 5px;
    }

    .checkout {
        display: block;
        text-align: center;
        background: darkorange;
    }

    .remove {
        background: darkred;
    }

</style>



<section class="cart">

    <h1>Shopping Cart</h1>
    <p>Review your selected products before checkout.</p>
    @foreach (var item in Model)
    {
        <div class="cart-item">
            <img src="~/electro/img/samsung game monitor2.jpg" alt="">
            <div class="product-info">
                <h3>@item.Adi</h3>                
                <h4>$@item.Fiyat</h4>
            </div>
            <div class="quantity">
                <label>Qty</label>
                <input type="number" value="@item.Adet" min="1">
            </div>
            <div class="price">
                <h3>$@(item.Fiyat * item.Adet)</h3>
            </div>
            <a href="#" class="remove">Remove</a>
        </div>
    }
    
 

    <div class="summary">

        <h2>Order Summary</h2>        
        <p>Subtotal <span>$ @(Model.Sum(i => i.Fiyat * i.Adet))</span></p>
        <p>Shipping <span>Free</span></p>
        <p><strong>Total <span>$ @(Model.Sum(i => i.Fiyat * i.Adet))</span></strong></p>

        <a href="~/Dashboard/Checkout" class="checkout">Proceed to Checkout</a>

    </div>

</section>
