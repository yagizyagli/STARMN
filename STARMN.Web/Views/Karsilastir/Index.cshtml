@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}


<style>
    .compare {
        width: 1000px;
        margin: 50px auto;
    }

    .compare h1 {
      margin-bottom: 10px;
    }

    .compare p {
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border: 1px solid white;
    }

    th {
        background: darkorange;
        color: white;
        padding: 10px;
    }

    td {
        padding: 10px;
        text-align: center;
    }

    th, td {
        border: 1px solid white;
    }

    }
</style>

