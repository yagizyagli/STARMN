@using STARMN.Database.Entities

@{
    ViewData["Title"] = "Dashboard v3";
    Layout = "~/Areas/AdminPanel/Views/Shared/_Layout.cshtml";
}



<main class="app-main">
    <div class="app-content">
        <div class="container-fluid">

            <div class="col-lg-12">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header bg-primary">
                        <div class="card-title ">Sipariş Sil</div>
                    </div>
                    <form action="Delete" method="post" class="needs-validation" novalidate>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Müşteri Id</label>
                                    <input name="Id" type="text" class="form-control" id="validationCustom01" value="@Model.Id" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Müşteri Adı</label>
                                    <input name="Adi" type="text" class="form-control" id="validationCustom01" value="@Model.MusteriAdi" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom02" class="form-label">Sipariş Tarihi</label>
                                    <input name="Tarih" type="date" class="form-control" id="validationCustom02" value="@Model.Tarih" required />

                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom03" class="form-label">Toplam Tutar</label>
                                    <input name="ToplamTutar" type="text" class="form-control" id="validationCustom03" value="@Model.ToplamTutar" required />

                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-info" type="submit">Sipariş Sil</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/adminlte/dist/js/validationtemplate.js"></script>
}