@using STARMN.Database.Entities

@{
    ViewData["Title"] = "Dashboard v3";
    Layout = "~/Areas/AdminPanel/Views/Shared/_Layout.cshtml";
}



<main class="app-main">
    <div class="app-content">
        <div class="container-fluid">

            <div class="col-lg-12">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header bg-primary">
                        <div class="card-title ">Sipariş Detayı Ekle</div>
                    </div>
                    <form action="Create" method="post" class="needs-validation" novalidate>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Miktar</label>
                                    <input name="Miktar" type="text" class="form-control" id="validationCustom01" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom02" class="form-label">Birim Fiyatı</label>
                                    <input name="BirimFiyat" type="text" class="form-control" id="validationCustom02" required />

                                </div>
                                <div class="col-md-12">

                                    <select name="OrderId" class="form-control">
                                        <option value="0">Sipariş Seçin</option>
                                        @foreach (var item in ViewBag.Siparisler)
                                        {
                                            <option value="@item.Id">@item.MusteriAdi</option>
                                        }
                                    </select>
                                    <select name="ProductId" class="form-control">
                                        <option value="0">Ürün Seçin</option>
                                        @foreach (var item in ViewBag.Urunler)
                                        {
                                            <option value="@item.Id">@item.Adi</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-info" type="submit">Sipariş Detayı Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/adminlte/dist/js/validationtemplate.js"></script>
}