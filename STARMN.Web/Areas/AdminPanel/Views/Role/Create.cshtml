@using STARMN.Database.Entities

@{
    ViewData["Title"] = "Dashboard v3";
    Layout = "~/Areas/AdminPanel/Views/Shared/_Layout.cshtml";
}



<main class="app-main">
    <div class="app-content">
        <div class="container-fluid">

            <div class="col-lg-12">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header bg-primary">
                        <div class="card-title ">Rol Ekle</div>
                    </div>
                    <form action="Create" method="post" class="needs-validation" novalidate>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Rol Adı</label>
                                    <input name="adi" type="text" class="form-control" id="validationCustom01" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom02" class="form-label">Açıklama</label>
                                    <input name="aciklama" type="text" class="form-control" id="validationCustom02" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom03" class="form-label">Şirket</label>
                                    <input name="sirket" type="text" class="form-control" id="validationCustom03" required />
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-info" type="submit">Rol Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/adminlte/dist/js/validationtemplate.js"></script>
}