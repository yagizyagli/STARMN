@{
    ViewData["Title"] = "Dashboard v3";
    Layout = "~/Areas/AdminPanel/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <div class="app-content">
        <div class="container-fluid">

            <div class="col-lg-12">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header bg-primary">
                        <div class="card-title ">Kullanıcı Güncelle</div>
                    </div>
                    <form action="Update" method="post" class="needs-validation" novalidate>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Kullanıcı Id</label>
                                    <input name="Id" type="text" class="form-control" id="validationCustom01" value="@Model.Id" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Kullanıcı Adı</label>
                                    <input name="KullaniciAdi" type="text" class="form-control" id="validationCustom01" value="@Model.KullaniciAdi" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Email </label>
                                    <input name="Email" type="email" class="form-control" id="validationCustom01" value="@Model.Email" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Telefon </label>
                                    <input name="Tel" type="tel" class="form-control" id="validationCustom01" value="@Model.Tel" required />
                                </div>
                                <div class="col-md-12">
                                    <label for="validationCustom01" class="form-label">Şifre </label>
                                    <input name="Sifre" type="password" class="form-control" id="validationCustom01" value="@Model.Sifre" required />
                                </div>
                                <div class="col-md-12">

                                    <select name="RoleId" class="form-control">
                                        <option value="0">Rol Seçin</option>
                                        @foreach (var item in ViewBag.Roller)
                                        {
                                            <option value="@item.RoleId">@item.RolAdi</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-info" type="submit">Kullanıcı Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/adminlte/dist/js/validationtemplate.js"></script>
}